-- 4. ระบบ Anti-Sit (Toggleable)
-- ====================================================================
local isAntiSitOn = false
local antiSitConn = nil

local function ToggleAntiSit()
    isAntiSitOn = not isAntiSitOn
    if isAntiSitOn then
        antiSitConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and (hum.Sit or hum:GetState() == Enum.HumanoidStateType.Seated) then
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    else
        if antiSitConn then antiSitConn:Disconnect(); antiSitConn = nil end
    end
end

