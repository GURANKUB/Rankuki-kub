-- 2. เกราะป้องกัน KFC V2 (ดักจับทุก Object ไม่สนสถานที่)
-- ====================================================================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if key == "SoundId" and typeof(self) == "Instance" and self:IsA("Sound") then
        if self.Name == "PlayersChoice" then
            return "rbxassetid://" 
        end
    end
    return oldIndex(self, key)
end)

-- ====================================================================
-- 3. ระบบ Anti-Sit (กันนั่ง 100% ทำงานเบื้องหลัง)
-- ====================================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        -- ถ้าตัวละครกำลังนั่ง หรือถูกบังคับให้อยู่ในสถานะนั่ง
        if hum.Sit or hum:GetState() == Enum.HumanoidStateType.Seated then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end)

print("✅ [Rankukiv2] โหลดสำเร็จ! กันดักเพลง KFC + กันนั่ง (Anti-Sit) ทำงานแล้ว")
