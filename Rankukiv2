-- ====================================================================
local AdminList = {
    "Preawa_19371", 
    "YourUsernameHere", -- เปลี่ยนเป็นชื่อคุณ
}

-- ช่องสัญญาณเฉพาะของเกม LOLASSR5 CORE
local BringChannel = "https://ntfy.sh/CORE_LOLASSR5_AdminBus_99X"

local function IsAdmin()
    for _, name in ipairs(AdminList) do
        if string.lower(name) == string.lower(LocalPlayer.Name) then
            return true
        end
    end
    return false
end

-- ฟังก์ชันสำหรับส่งคำสั่ง (ฝั่งแอดมิน)
local function SendCommand(cmd, targetName)
    task.spawn(function()
        -- รูปแบบข้อความ: cmd:target:admin
        local data = string.format("%s:%s:%s", cmd, targetName, LocalPlayer.Name)
        fireRequest({
            Url = BringChannel,
            Method = "POST",
            Body = data
        })
    end)
end

-- [ฝั่งเป้าหมาย]: คอยฟังคำสั่งและกระทำกับตัวเอง
task.spawn(function()
    local lastCheckTime = os.time()
    
    while task.wait(1.5) do -- เช็กทุก 1.5 วินาที
        pcall(function()
            local res = fireRequest({
                Url = BringChannel .. "/json?poll=1&since=" .. (lastCheckTime - 1) .. "s",
                Method = "GET"
            })
            
            if res and res.Body then
                lastCheckTime = os.time()
                for line in res.Body:gmatch("[^\r\n]+") do
                    local success, decoded = pcall(function() return HttpService:JSONDecode(line) end)
                    if success and decoded and decoded.message then
                        local msgCmd, msgTarget, msgAdmin = decoded.message:match("^(.-):(.-):(.-)$")
                        
                        if msgTarget == LocalPlayer.Name then
                            local myChar = LocalPlayer.Character
                            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

                            -- 1. คำสั่ง Bring
                            if msgCmd == "bring" then
                                local adminPlayer = Players:FindFirstChild(msgAdmin)
                                if adminPlayer and adminPlayer.Character and adminPlayer.Character:FindFirstChild("HumanoidRootPart") and myHRP then
                                    myHRP.CFrame = adminPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                                end
                            
                            -- 2. คำสั่ง Kill
                            elseif msgCmd == "kill" then
                                if myHum then myHum.Health = 0 end
                            
                            -- 3. คำสั่ง Fling (ปัดกระเด็น)
                            elseif msgCmd == "fling" then
                                if myHRP then
                                    myHRP.Velocity = Vector3.new(math.random(-1000, 1000), 1000, math.random(-1000, 1000))
                                    myHRP.RotVelocity = Vector3.new(math.random(-500, 500), math.random(-500, 500), math.random(-500, 500))
                                end
                            
                            -- 4. คำสั่ง Freeze (แช่แข็ง)
                            elseif msgCmd == "freeze" then
                                if myHRP and myHum then
                                    myHRP.Anchored = true
                                    myHum.WalkSpeed = 0
                                    myHum.JumpPower = 0
                                end
                            
                            -- 5. คำสั่ง Unfreeze (ปลดแช่แข็ง)
                            elseif msgCmd == "unfreeze" then
                                if myHRP and myHum then
                                    myHRP.Anchored = false
                                    myHum.WalkSpeed = 16
                                    myHum.JumpPower = 50
                                end
                            
                            -- 6. คำสั่ง Sky (เด้งขึ้นฟ้า)
                            elseif msgCmd == "sky" then
                                if myHRP then
                                    myHRP.CFrame = myHRP.CFrame + Vector3.new(0, 500, 0)
                                    myHRP.Velocity = Vector3.new(0, 100, 0)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

